# Optional. Only needed if you want WalletConnect wallets in the connect modal.
# 1. Go to https://cloud.walletconnect.com
# 2. Create a project and paste the ID
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Base CDP Project ID — required for email sign-in (Coinbase mails the code).
# 1. https://portal.cdp.coinbase.com — copy Project ID
# 2. Wallets → Embedded Wallet → allow http://localhost:3000
NEXT_PUBLIC_CDP_PROJECT_ID=

# Base network: "testnet" (Base Sepolia, default) or "mainnet" (Base Mainnet)
NEXT_PUBLIC_NETWORK=testnet

# Deployed WHOT table
NEXT_PUBLIC_WHOT_ADDRESS=
